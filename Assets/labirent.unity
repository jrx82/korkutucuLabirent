--- !u!114 &1648082284
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1648082282}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\nTarih: Bursun yattigi gunden 20 gun sonra, sefalet cagi. Konum: B Blok,
    2.Kat Oda 205 (Lanetli Bolge)\n\nBu notu bulan merhametli yabanci,\n\nBen tukendim.
    Gun isigini en son ne zaman gordugumu, kantindeki tostcunun yuzunu ne zaman unuttugumu
    hatirlamiyorum. Goblin Faruk, odanin ucte ikisini kirli coraplarindan ve bos
    noodle kutularindan insa ettigi o igrenc surlarla kapatti. \"Burasi benim kralligim!\"
    diye bagirip ranzanin ust katindan uzerime mandalina kabuklari firlatiyor.\n\nGece
    oldugunda hiriltilari basliyor. Zannediyorum ki ruyasinda hala yemekhanedeki
    fazladan ekmekleri istifliyor. Oksijenimiz azaliyor dostum... Faruk, kettle'da
    yine ne oldugu belirsiz bir iksir (sanirim korili makarna ve kacak cay karisimi)
    kaynatti ve koku yuzunden cigerlerim iflas etmek uzere.\n\nDun gece en degerli
    hazinemi, son kalan temiz tuvalet kagidi rulomu caldi. Gozlerinin icine baktim,
    bana sadece hirladi ve \"Bu artik vergi!\" dedi.\n\nEger bu notu okuyorsan ve
    hala disaridaysan, memurlara haber verme; onlar Faruk'un magarasina girmekten
    korkuyor. Sadece anneme onu sevdigimi ve depozitomu yakmamalarini soyle.\n\nFaruk
    uyaniyor... Gozleri parliyor... Sanirim sarj aletimi isteyecek.\n\nElveda.\n\n\u2014
    Ranzanin Altindaki Mazlum"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
